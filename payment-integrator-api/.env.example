# Environment variables. Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real credentials.

DATABASE_URL=

PORT=

# Payment gateway sandbox (UAT) credentials.
# PAYMENT_GATEWAY_PUBLIC_KEY is the only one safe to expose to the frontend (card tokenization).
# PAYMENT_GATEWAY_PRIVATE_KEY and PAYMENT_GATEWAY_INTEGRITY_SECRET must stay backend-only, never logged.
# PAYMENT_GATEWAY_EVENTS_KEY is provisioned for future webhook signature verification — not used
# by this API yet, since this scope uses polling instead of webhooks (see README).
PAYMENT_GATEWAY_BASE_URL=
PAYMENT_GATEWAY_PUBLIC_KEY=
PAYMENT_GATEWAY_PRIVATE_KEY=
PAYMENT_GATEWAY_INTEGRITY_SECRET=
PAYMENT_GATEWAY_EVENTS_KEY=
